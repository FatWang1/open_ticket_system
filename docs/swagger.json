                    "description": "创建者",
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "张三"
                },
                "memo": {
                    "description": "工单备注",
                    "type": "string",
                    "maxLength": 1000,
                    "example": "需要请假3天"
                },
                "name": {
                    "description": "工单名称",
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "请假申请"
                },
                "template_id": {
                    "description": "模板ID",
                    "type": "integer",
                    "example": 1
