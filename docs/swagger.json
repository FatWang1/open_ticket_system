    "definitions": {
        "models.ApprovalRequest": {
            "description": "工单审批请求结构",
            "type": "object",
            "required": [
                "approval_user",
                "id",
                "next_step",
                "operation"
            ],
            "properties": {
                "approval_user": {
                    "description": "审批人",
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "李四"
                },
                "id": {
                    "description": "工单ID",
                    "type": "integer",
                    "example": 1
                },
                "memo": {
                    "description": "审批备注",
                    "type": "string",
                    "maxLength": 1000,
                    "example": "同意"
                },
                "next_step": {
                    "description": "下一步骤",
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "step2"
                },
                "operation": {
                    "description": "审批操作",
                    "type": "string",
                    "enum": [
                        "approve",
                        "reject"
                    ],
                    "example": "approve"
                }
            }
        },
        "models.CloseTicketRequest": {
            "type": "object",
            "required": [
                "id",
                "operator"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "memo": {
                    "type": "string",
