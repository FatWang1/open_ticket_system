            "type": "object",
            "properties": {
                "created_at": {
                    "description": "创建时间",
                    "type": "string",
                    "example": "2025-01-27T14:30:00Z"
                },
                "id": {
                    "description": "工单ID",
                    "type": "integer",
                    "example": 1
